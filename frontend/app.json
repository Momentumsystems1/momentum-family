{
  "expo": {
    "name": "Sentinel Family",
    "slug": "sentinel-family",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sentinel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momentumsystems.sentinel",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Compartir tu ubicación con tu grupo",
        "NSCameraUsageDescription": "Grabar incidencias de la vía voluntariamente",
        "NSMicrophoneUsageDescription": "Registrar incidencias por voz",
        "NSPhotoLibraryUsageDescription": "Elegir tu foto de perfil"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09101C"
      },
      "package": "com.momentumsystems.sentinel",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Compartir tu ubicación con tu grupo"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "dctinvent.com",
    "extra": {
      "eas": {
        "projectId": "23176eaf-b779-4840-8f1e-f7f7e6d5d9fe"
      }
    }
  }
}
