# My Cluster recovery — copy as frontend/.env (do not commit real values)
# Use your computer's LAN IP when testing with a physical phone.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.100:8000

# Working default: FastAPI + MongoDB. Supabase is optional.
EXPO_PUBLIC_AUTH_BACKEND=fastapi

# Only set these for a validated Supabase Auth integration.
# Expo public variables are visible in the app; NEVER use a service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Build-time only: set these through EAS preview/development environment
# when configuring native Google Maps. NEVER commit actual values.
# Do not add EXPO_PUBLIC_ to either key.
# G3000_MAPS_ANDROID_API_KEY=
# G3000_MAPS_IOS_API_KEY=
