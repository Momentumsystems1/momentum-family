# My Cluster recovery — copy as backend/.env; never commit backend/.env
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=my_cluster_dev
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES
ACCESS_MINUTES=20
REFRESH_DAYS=30
APP_PUBLIC_URL=http://localhost:8081
TERMS_VERSION=2026-06-01

# Legacy provider: do not configure. Google Maps migration is pending.
AZURE_MAPS_KEY=

# Only when using Supabase as an auth backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
