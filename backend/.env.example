# My Cluster recovery — copy as backend/.env; never commit backend/.env
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=my_cluster_dev
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES
ACCESS_MINUTES=20
REFRESH_DAYS=30
APP_PUBLIC_URL=http://localhost:8081
TERMS_VERSION=2026-06-01

# Legacy provider: do not configure. Google Maps migration is pending.
AZURE_MAPS_KEY=

# Only when using Supabase as an auth backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# G3000 / BAYMOVE environmental and route services — FUTURE, NOT YET WIRED.
# Restricted server-side key (Weather, Air Quality, Pollen, Routes, Places New, Geocoding).
# NEVER expose this value through EXPO_PUBLIC_* or commit a real .env.
G3000_MAPS_SERVER_API_KEY=
# Optional authoritative incident/weather adapters after P1 core validation.
AEMET_OPENDATA_API_KEY=
TOMTOM_API_KEY=

# Futuras fuentes de transporte público en tiempo real (no configuradas ni conectadas).
# NAP Transportes y NAP DGT no comparten una clave universal.
TMB_APP_ID=
TMB_APP_KEY=
EMT_MADRID_API_KEY=
